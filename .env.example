# Template for the live shift. Copy to .env in the repo root.
# The API loads .env on startup. A variable already set in the shell is left as-is.
# See howtorun.md.
#
# Choose the counter model: local, openai, or anthropic.
# local uses DeskChatModel and does not call a provider.
CITYDESK_PROVIDER=local

# Exact model. With CITYDESK_PROVIDER=openai, examples:
#   openai:gpt-6.1-sol     complex replies, lower cost than Astra
#   openai:gpt-6-astra
#   openai:gpt-6.1-terra
#   openai:gpt-6-luna      cheapest, high volume
# Leave empty to use openai:gpt-6.1-sol.
# anthropic:claude-sonnet-4-5 requires langchain-anthropic and ANTHROPIC_API_KEY
CITYDESK_MODEL=

# Set only the key for the provider named in CITYDESK_PROVIDER.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
